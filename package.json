{
  "name": "building-code-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "validate:boundary": "node scripts/public-boundary.mjs",
    "validate:demo": "node -e \"const fs=require('fs'); const x=JSON.parse(fs.readFileSync('demo/DEMO-XX/project-code-basis.json','utf8')); if(x.jurisdiction_id!=='DEMO-XX') process.exit(1);\"",
    "validate:provider-contract": "node --experimental-strip-types scripts/provider-contract.ts test/fixtures/provider-contract/valid.json demo/DEMO-XX/provider-contract.json",
    "validate": "npm run validate:boundary && npm run validate:demo && npm run validate:provider-contract",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
