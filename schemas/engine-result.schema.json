{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/engine-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "location", "resolution", "provenance", "diagnostics"],
  "properties": {
    "schema_version": { "type": "string" },
    "query": { "$ref": "engine-query.schema.json" },
    "location": { "type": "object" },
    "resolution": { "type": "object" },
    "provenance": { "$ref": "engine-bundle.schema.json#/definitions/provenance" },
    "diagnostics": { "type": "array", "items": { "type": "object" } }
  }
}
