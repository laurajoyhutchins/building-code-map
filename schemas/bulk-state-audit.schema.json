{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/building-code-map/schemas/bulk-state-audit.schema.json",
  "title": "BCM candidate-only state coverage audit v1",
  "description": "A cartographic sampling audit, never a legal jurisdiction determination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "source_geometry_sha256",
    "workload_sha256",
    "samples",
    "states",
    "state_candidate_counts",
    "unsampled_states",
    "unmatched_points",
    "overlapping_candidate_points",
    "unmatched_ids",
    "overlapping_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "classification": {
      "const": "source_geography_candidate_only"
    },
    "source_geometry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "integer",
      "minimum": 0
    },
    "states": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "state_candidate_counts": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]{2}$": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "unsampled_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      }
    },
    "unmatched_points": {
      "type": "integer",
      "minimum": 0
    },
    "overlapping_candidate_points": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlapping_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
