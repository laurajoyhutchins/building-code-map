{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/engine-query.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "address": { "type": "string" },
    "code_family": { "type": "string" },
    "project_type": { "type": "string" },
    "applicability_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "include": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "oneOf": [{ "required": ["point"] }, { "required": ["address"] }]
}
