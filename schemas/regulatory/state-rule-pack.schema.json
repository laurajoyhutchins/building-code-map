{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/building-code-map/schemas/regulatory/state-rule-pack.schema.json",
  "title": "Building Code Map State Rule Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "state_id": { "type": "string", "pattern": "^US-[A-Z]{2}$" },
    "source_health": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sourceHealth" }
    },
    "applicability_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/applicabilityRule" }
    },
    "date_rules": { "type": "array", "items": { "$ref": "#/$defs/dateRule" } },
    "amendment_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/amendmentRule" }
    },
    "enforcement_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/enforcementRule" }
    },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "resolver_fixture_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["verified", "partially_verified", "needs_review", "unresolved"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    },
    "sourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_checked_at": { "type": "string", "format": "date" },
        "availability": { "enum": ["available", "unavailable", "moved", "unknown"] }
      }
    },
    "ruleBase": {
      "type": "object",
      "required": ["id", "summary", "source_ids", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code_family": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "applicabilityRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "trigger", "summary", "source_ids", "verification"],
          "properties": {
            "id": { "type": "string" },
            "code_family": { "type": "string" },
            "project_types": { "type": "array", "items": { "type": "string" } },
            "trigger": { "type": "string", "minLength": 1 },
            "applies_to": { "type": "array", "items": { "type": "string" } },
            "exclusions": { "type": "array", "items": { "type": "string" } },
            "summary": { "type": "string" },
            "source_ids": { "$ref": "#/$defs/sourceIds" },
            "verification": { "$ref": "#/$defs/verification" }
          }
        }
      ]
    },
    "dateRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_type", "trigger", "summary", "source_ids", "verification"],
      "properties": {
        "id": { "type": "string" },
        "code_family": { "type": "string" },
        "rule_type": { "type": "string" },
        "trigger": { "type": "string" },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "prior_code_allowed": { "type": "boolean" },
        "summary": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "amendmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "posture", "summary", "source_ids", "verification"],
      "properties": {
        "id": { "type": "string" },
        "code_family": { "type": "string" },
        "level": { "type": "string" },
        "authority_id": { "type": "string" },
        "posture": { "type": "string" },
        "summary": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "enforcementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "entity_kinds", "summary", "source_ids", "verification"],
      "properties": {
        "id": { "type": "string" },
        "code_family": { "type": "string" },
        "model": { "type": "string" },
        "entity_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "authority_ids": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_id", "field", "status", "source_ids", "verification"],
      "properties": {
        "id": { "type": "string" },
        "subject_id": { "type": "string" },
        "field": { "type": "string" },
        "status": {
          "enum": ["supported", "conflicting", "unknown", "not_applicable", "superseded"]
        },
        "value": {},
        "conflict_group": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    }
  }
}
