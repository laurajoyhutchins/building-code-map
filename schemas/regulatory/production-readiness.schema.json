{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/building-code-map/schemas/regulatory/production-readiness.schema.json",
  "title": "Building Code Map Pilot Production Readiness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "scope",
    "primary_source_ids",
    "required_fixture_kinds",
    "timelines",
    "fixtures"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "state_id": { "type": "string", "pattern": "^US-[A-Z]{2}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_families", "start_date", "end_date"],
      "properties": {
        "code_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },
    "primary_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_fixture_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "incorporated",
          "unincorporated",
          "special_project",
          "missing_evidence",
          "conflict",
          "historical"
        ]
      }
    },
    "timelines": {
      "type": "array",
      "items": { "$ref": "#/$defs/timeline" }
    },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["verified", "partially_verified", "needs_review", "unresolved"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_family",
        "start_date",
        "end_date",
        "adoption_ids",
        "source_ids",
        "verification"
      ],
      "properties": {
        "code_family": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "adoption_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "jurisdiction",
        "code_families",
        "applicability_date",
        "expected_status",
        "production_supported",
        "source_ids",
        "local_source_ids",
        "verification"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "incorporated",
            "unincorporated",
            "special_project",
            "missing_evidence",
            "conflict",
            "historical"
          ]
        },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "code_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "applicability_date": { "type": "string", "format": "date" },
        "expected_status": {
          "enum": [
            "resolved",
            "partially_resolved",
            "local_record_required",
            "ambiguous",
            "conflicting",
            "insufficient_evidence"
          ]
        },
        "production_supported": { "type": "boolean" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "local_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification": { "$ref": "#/$defs/verification" }
      }
    }
  }
}
