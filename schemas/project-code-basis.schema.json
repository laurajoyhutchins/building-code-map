{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/project-code-basis.schema.json",
  "title": "Building Code Map Project Code Basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "as_of",
    "inputs",
    "jurisdiction_id",
    "jurisdiction",
    "verdict",
    "code_set",
    "unresolved",
    "follow_up_questions",
    "evidence",
    "exact_evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.3" },
    "project_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["longitude", "latitude"],
          "properties": {
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
          }
        },
        "address": { "type": "string", "minLength": 1 },
        "project_type": { "type": "string", "minLength": 1 },
        "facts": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "oneOf": [
        { "required": ["address"] },
        { "required": ["point"] }
      ]
    },
    "jurisdiction_id": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "primary_jurisdiction_id", "primary_jurisdiction_name"],
      "properties": {
        "country_code": { "type": "string", "minLength": 2 },
        "primary_jurisdiction_id": { "type": "string", "minLength": 1 },
        "primary_jurisdiction_name": { "type": "string", "minLength": 1 },
        "census_state_equivalent_fips": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "enum": ["verified", "conditional", "not_verified"] },
    "code_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "status"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "edition": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "resolved",
              "partially_resolved",
              "local_record_required",
              "unsupported",
              "not_applicable",
              "insufficient_evidence",
              "ambiguous",
              "conflicting"
            ]
          },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "user_facts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "derived_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "message"],
        "properties": {
          "kind": { "enum": ["project_fact", "local_record", "evidence_defect"] },
          "message": { "type": "string", "minLength": 1 },
          "fact_key": { "type": "string", "minLength": 1 },
          "code_family": { "type": "string", "minLength": 1 }
        }
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exact_evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json#/$defs/evidence_link" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine_version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
