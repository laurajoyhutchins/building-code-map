{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/project-code-basis.schema.json",
  "title": "Building Code Map Project Code Basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "as_of",
    "jurisdiction_id",
    "verdict",
    "code_set",
    "unresolved",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": ["verified", "conditional", "not_verified"]
    },
    "code_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "edition", "basis"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "edition": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
