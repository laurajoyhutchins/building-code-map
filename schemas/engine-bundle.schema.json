{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/engine-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "source_commit",
    "created_at",
    "components",
    "coverage"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "engine_version": { "type": "string" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "components": { "type": "object", "minProperties": 2 },
    "coverage": { "type": "object", "required": ["states", "code_families", "as_of"] }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "required": [
        "source_commit",
        "engine_version",
        "bundle_manifest_digest",
        "boundary_snapshot_digest",
        "regulatory_catalog_digest"
      ]
    }
  }
}
