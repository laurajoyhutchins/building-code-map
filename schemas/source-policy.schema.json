{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://building-code-map.example/schemas/source-policy.schema.json",
  "title": "Building Code Map Source Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim_kind", "jurisdiction_id", "document_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim_kind": { "type": "string", "minLength": 1 },
          "jurisdiction_id": { "type": "string", "minLength": 1 },
          "document_id": { "type": "string", "minLength": 1 },
          "effective_from": { "type": "string", "format": "date" },
          "effective_to": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
