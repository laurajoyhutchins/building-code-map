{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/building-code-map/schemas/bulk-workload-v1.schema.json",
  "title": "BCM bulk query workload sample v1",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "point": {
      "type": "object",
      "required": [
        "longitude",
        "latitude"
      ],
      "additionalProperties": false,
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "applicability_date": {
      "type": "string",
      "format": "date"
    },
    "project_type": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crs",
        "column",
        "row",
        "step_metres",
        "land_fraction",
        "sample_kind"
      ],
      "properties": {
        "crs": {
          "const": "EPSG:6933"
        },
        "column": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        },
        "step_metres": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "land_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "sample_kind": {
          "enum": [
            "cell_center",
            "land_representative_point"
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_key",
        "feature_id",
        "neighbor_feature_id",
        "side",
        "offset_metres",
        "crs",
        "classification"
      ],
      "properties": {
        "pair_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "feature_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,100}$"
        },
        "neighbor_feature_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,100}$"
        },
        "side": {
          "enum": [
            "a",
            "b"
          ]
        },
        "offset_metres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5000
        },
        "crs": {
          "const": "EPSG:6933"
        },
        "classification": {
          "const": "source_polygon_candidate_only"
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "transition_date",
        "offset_days",
        "source_sha256",
        "classification"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,70}$"
        },
        "transition_date": {
          "type": "string",
          "format": "date"
        },
        "offset_days": {
          "type": "integer",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "classification": {
          "const": "source_date_candidate_only"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "kind",
        "source_feature_id",
        "containing_feature_ids",
        "baseline_sampled",
        "crs"
      ],
      "properties": {
        "classification": {
          "const": "source_geometry_candidate_only"
        },
        "kind": {
          "enum": [
            "unrepresented_feature_candidate",
            "nested_feature_candidate",
            "interior_void_candidate"
          ]
        },
        "source_feature_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 130,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "containing_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100000,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_sampled": {
          "const": false
        },
        "crs": {
          "const": "EPSG:6933"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "point"
      ],
      "not": {
        "required": [
          "address"
        ]
      }
    },
    {
      "required": [
        "address"
      ],
      "not": {
        "required": [
          "point"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "boundary"
        ]
      },
      "then": {
        "required": [
          "source_sha256",
          "point"
        ]
      }
    },
    {
      "if": {
        "required": [
          "temporal"
        ]
      },
      "then": {
        "required": [
          "applicability_date"
        ]
      }
    },
    {
      "if": {
        "required": [
          "gap"
        ]
      },
      "then": {
        "required": [
          "point",
          "source_sha256"
        ]
      }
    }
  ]
}
